{
  "title": "Healthcare Readmission Risk API — Overview",
  "uid": "readmission-api-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Prediction Requests (rate, 5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(readmission_predictions_total[5m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(readmission_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p50 {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(readmission_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p95 {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(readmission_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p99 {{endpoint}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Process CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"readmission-api\"}[5m])",
          "legendFormat": "CPU seconds/sec"
        }
      ]
    },
    {
      "id": 4,
      "title": "Process Memory (RSS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"readmission-api\"}",
          "legendFormat": "RSS bytes"
        }
      ]
    },
    {
      "id": 5,
      "title": "API Errors (rate, 5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(readmission_api_errors_total[5m])) by (endpoint, error_type)",
          "legendFormat": "{{endpoint}} - {{error_type}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Prediction Class Distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(readmission_predictions_total) by (prediction_label)",
          "legendFormat": "{{prediction_label}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Total Predictions Served",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(readmission_predictions_total)"
        }
      ]
    }
  ]
}
