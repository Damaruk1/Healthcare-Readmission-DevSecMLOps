# Copy to .env and fill in for local development.
# The API and pipeline scripts read configuration primarily from
# configs/config.yaml; these env vars are optional overrides / secrets
# that should never be committed.

# Override which config file is loaded (defaults to configs/config.yaml)
HEALTHCARE_MLOPS_CONFIG=configs/config.yaml

# Used only by CI for the Safety CLI's cloud vulnerability database
SAFETY_API_KEY=

# Used only by CI post-deploy smoke tests
DEPLOY_URL=
