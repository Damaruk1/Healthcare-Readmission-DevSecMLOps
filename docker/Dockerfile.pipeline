# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Healthcare Readmission Risk — training/pipeline image
# Used for one-off pipeline runs: data gen, validation, preprocessing,
# training, evaluation, drift checks. Not exposed as a service.
# ---------------------------------------------------------------------------

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN mkdir -p logs data/raw data/processed data/validated models reports

# Default: run the full pipeline end-to-end. Override CMD to run a single stage.
CMD ["sh", "-c", "\
    python src/data_generation/generate_data.py && \
    python src/validation/validate_data.py && \
    python src/validation/eda.py && \
    python src/preprocessing/preprocess.py && \
    python src/training/train.py && \
    python src/evaluation/evaluate.py && \
    python src/monitoring/drift_detection.py \
    "]
